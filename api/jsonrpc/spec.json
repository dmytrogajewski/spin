{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JSON-RPC 2.0 Schema for Spin MCP Implementation",
  "description": "JSON Schema definitions for JSON-RPC 2.0 messages used in Spin's MCP implementation",
  "definitions": {
    "id": {
      "description": "An identifier established by the Client. Must be a String, Number, or NULL value if included.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "jsonrpcVersion": {
      "type": "string",
      "const": "2.0",
      "description": "A String specifying the version of the JSON-RPC protocol. MUST be exactly '2.0'."
    },
    "errorCode": {
      "type": "integer",
      "description": "A Number that indicates the error type that occurred.",
      "enum": [
        -32700,
        -32600,
        -32601,
        -32602,
        -32603,
        -32000,
        -32001,
        -32002,
        -32003,
        -32004,
        -32005,
        -32006,
        -32007,
        -32008,
        -32009,
        -32010,
        -32099
      ]
    },
    "error": {
      "type": "object",
      "description": "Error object for JSON-RPC 2.0",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "$ref": "#/definitions/errorCode"
        },
        "message": {
          "type": "string",
          "description": "A String providing a short description of the error."
        },
        "data": {
          "description": "A Primitive or Structured value that contains additional information about the error."
        }
      }
    },
    "request": {
      "type": "object",
      "description": "A JSON-RPC 2.0 request object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/definitions/jsonrpcVersion"
        },
        "method": {
          "type": "string",
          "description": "A String containing the name of the method to be invoked.",
          "pattern": "^[a-zA-Z0-9_/-]+$"
        },
        "params": {
          "description": "A Structured value that holds the parameter values to be used during the invocation of the method.",
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        },
        "id": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "notification": {
      "type": "object",
      "description": "A JSON-RPC 2.0 notification (request without id)",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/definitions/jsonrpcVersion"
        },
        "method": {
          "type": "string",
          "description": "A String containing the name of the method to be invoked."
        },
        "params": {
          "description": "A Structured value that holds the parameter values to be used during the invocation of the method.",
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        }
      }
    },
    "successResponse": {
      "type": "object",
      "description": "A JSON-RPC 2.0 success response",
      "required": ["jsonrpc", "result", "id"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/definitions/jsonrpcVersion"
        },
        "result": {
          "description": "The result of the method invocation. Required on success."
        },
        "id": {
          "$ref": "#/definitions/id"
        }
      },
      "not": {
        "required": ["error"]
      }
    },
    "errorResponse": {
      "type": "object",
      "description": "A JSON-RPC 2.0 error response",
      "required": ["jsonrpc", "error", "id"],
      "properties": {
        "jsonrpc": {
          "$ref": "#/definitions/jsonrpcVersion"
        },
        "error": {
          "$ref": "#/definitions/error"
        },
        "id": {
          "$ref": "#/definitions/id"
        }
      },
      "not": {
        "required": ["result"]
      }
    },
    "response": {
      "description": "A JSON-RPC 2.0 response (either success or error)",
      "oneOf": [
        {
          "$ref": "#/definitions/successResponse"
        },
        {
          "$ref": "#/definitions/errorResponse"
        }
      ]
    },
    "batch": {
      "type": "array",
      "description": "A JSON-RPC 2.0 batch request or response",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/request"
          },
          {
            "$ref": "#/definitions/notification"
          },
          {
            "$ref": "#/definitions/response"
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/request"
    },
    {
      "$ref": "#/definitions/notification"
    },
    {
      "$ref": "#/definitions/response"
    },
    {
      "$ref": "#/definitions/batch"
    }
  ],
  "examples": [
    {
      "description": "Request with positional parameters",
      "value": {
        "jsonrpc": "2.0",
        "method": "subtract",
        "params": [42, 23],
        "id": 1
      }
    },
    {
      "description": "Request with named parameters",
      "value": {
        "jsonrpc": "2.0",
        "method": "subtract",
        "params": {
          "minuend": 42,
          "subtrahend": 23
        },
        "id": 2
      }
    },
    {
      "description": "Notification (no id)",
      "value": {
        "jsonrpc": "2.0",
        "method": "update",
        "params": [1, 2, 3, 4, 5]
      }
    },
    {
      "description": "Success response",
      "value": {
        "jsonrpc": "2.0",
        "result": 19,
        "id": 1
      }
    },
    {
      "description": "Error response",
      "value": {
        "jsonrpc": "2.0",
        "error": {
          "code": -32601,
          "message": "Method not found"
        },
        "id": 1
      }
    },
    {
      "description": "Batch request",
      "value": [
        {
          "jsonrpc": "2.0",
          "method": "sum",
          "params": [1, 2, 4],
          "id": "1"
        },
        {
          "jsonrpc": "2.0",
          "method": "notify_hello",
          "params": [7]
        },
        {
          "jsonrpc": "2.0",
          "method": "subtract",
          "params": [42, 23],
          "id": "2"
        }
      ]
    }
  ]
}
